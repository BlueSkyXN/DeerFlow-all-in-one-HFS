# Hugging Face Space Settings -> Secrets
# Do not commit real values.

# Choose at least one model provider that matches /data/deer-flow/config.yaml.
OPENROUTER_API_KEY=replace-me
OPENAI_API_KEY=replace-me

# Strongly recommended. Generate long random values and keep them stable.
BETTER_AUTH_SECRET=replace-with-long-random-string
DEER_FLOW_INTERNAL_AUTH_TOKEN=replace-with-another-long-random-string

# Token-protected operations and admin surfaces.
DEER_FLOW_OPS_TOKEN=replace-with-ops-token
DEER_FLOW_ADMIN_TOKEN=replace-with-admin-token

# Optional search/fetch providers.
TAVILY_API_KEY=replace-me
SERPER_API_KEY=replace-me
JINA_API_KEY=replace-me
EXA_API_KEY=replace-me
FIRECRAWL_API_KEY=replace-me
INFOQUEST_API_KEY=replace-me
