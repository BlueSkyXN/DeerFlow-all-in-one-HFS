# Copy to .env.local for local docker run.
# Do not commit .env.local.

DEER_FLOW_ENV=local-hfs-demo
DEER_FLOW_PROJECT_ROOT=/home/user/app/deer-flow
DEER_FLOW_HOME=/data/deer-flow
DEER_FLOW_DB_DIR=/data/deer-flow/data
DEER_FLOW_CONFIG_PATH=/data/deer-flow/config.yaml
DEER_FLOW_EXTENSIONS_CONFIG_PATH=/data/deer-flow/extensions_config.json
DEER_FLOW_SKILLS_PATH=/home/user/app/deer-flow/skills
DEER_FLOW_MANAGED_CONFIG=true
GATEWAY_WORKERS=1
GATEWAY_ENABLE_DOCS=true
GATEWAY_CORS_ORIGINS=http://localhost:7860
DEER_FLOW_TRUSTED_ORIGINS=http://localhost:7860
HF_HOME=/data/hf
DEER_FLOW_OPS_PORT=8081
DEER_FLOW_OPS_SESSION_TTL_SECONDS=3600
DEER_FLOW_OPS_COOKIE_SECURE=auto
DEER_FLOW_OPS_DEFAULT_CHECKS_ENABLED=true
DEER_FLOW_OPS_LOG_DIR=/data/deer-flow/logs
DEER_FLOW_OPS_LOG_LINES_MAX=1000
DEER_FLOW_OPS_LOG_TAIL_MAX_BYTES=1048576
DEER_FLOW_ADMIN_PORT=8082
# Local-only convenience for testing token-protected admin APIs.
# Do not reuse this setting or the placeholder token values for a public Space or tunnel.
DEER_FLOW_ADMIN_ENABLED=true
DEER_FLOW_ADMIN_ACTIONS_ENABLED=false

# Choose at least one.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Recommended for stable local sessions.
AUTH_JWT_SECRET=local-dev-auth-jwt-secret-change-me
DEER_FLOW_INTERNAL_AUTH_TOKEN=local-dev-internal-auth-token-change-me
DEER_FLOW_OPS_TOKEN=local-dev-ops-token-change-me
DEER_FLOW_ADMIN_TOKEN=local-dev-admin-token-change-me

# Optional.
TAVILY_API_KEY=
SERPER_API_KEY=
JINA_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
INFOQUEST_API_KEY=
