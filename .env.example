# HFS value ledger template. Copy to the ignored .env and fill only the
# names that need HFS synchronization. Do not use this file for local Docker
# runs; Makefile intentionally continues to default to .env.local.
#
# Key classification is registered in hfs-dev.toml. Values are intentionally
# omitted from this public template.

# HFS Secrets
ADMIN_PASSWORD=
AUTH_JWT_SECRET=
BETTER_AUTH_SECRET=
DEER_FLOW_INTERNAL_AUTH_TOKEN=
OPS_TOKEN=
EXA_API_KEY=
FIRECRAWL_API_KEY=
INFOQUEST_API_KEY=
JINA_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# HFS Variables
ADMIN_USERNAME=
DEER_FLOW_ADMIN_ACTIONS_ENABLED=
DEER_FLOW_ADMIN_ENABLED=
DEER_FLOW_ADMIN_PORT=
DEER_FLOW_CONFIG_PATH=
DEER_FLOW_DB_DIR=
DEER_FLOW_ENV=
DEER_FLOW_EXTENSIONS_CONFIG_PATH=
DEER_FLOW_HOME=
DEER_FLOW_MANAGED_CONFIG=
DEER_FLOW_OPS_COOKIE_SECURE=
DEER_FLOW_OPS_DEFAULT_CHECKS_ENABLED=
DEER_FLOW_OPS_LOG_DIR=
DEER_FLOW_OPS_LOG_LINES_MAX=
DEER_FLOW_OPS_LOG_TAIL_MAX_BYTES=
DEER_FLOW_OPS_PORT=
DEER_FLOW_OPS_SESSION_TTL_SECONDS=
DEER_FLOW_PROJECT_ROOT=
DEER_FLOW_SKILLS_PATH=
DEER_FLOW_TRUSTED_ORIGINS=
GATEWAY_CORS_ORIGINS=
GATEWAY_ENABLE_DOCS=
GATEWAY_WORKERS=
HF_HOME=
